{
  "name": "@rylorin/yuh2ofx",
  "version": "0.1.4",
  "private": false,
  "description": "Convert Yuh statements reports to OFX format  ",
  "repository": {
    "type": "github",
    "url": "https://github.com/rylorin/yuh2ofx.git"
  },
  "license": "MIT",
  "author": "Ronan-Yann Lorin <ryl@free.fr>",
  "bin": {
    "yuh2ofx": "dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "NODE_ENV=development tsx src/index",
    "lint": "prettier --check ./src && eslint ./src",
    "prepublishOnly": "yarn build",
    "qc": "yarn lint && yarn type-check",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "yarn qc",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.ts": "yarn lint",
    "*.{ts,json,md}": "prettier --check"
  },
  "dependencies": {
    "command-line-args": "^6.0.2",
    "pdf2json": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/command-line-args": "^5.2.3",
    "@types/node": "^22.20.1",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
